# Production build values for the VPS deploy (resume.thetan.in).
#
# Vite bakes these into the bundle at BUILD time — they are not read at runtime.
# Changing anything here requires a rebuild + redeploy, not just a restart.
#
# Committed on purpose: nothing here is secret, and CI needs it to produce a
# correct bundle. Never put API keys in a VITE_* variable — they ship to the
# browser in plain text.

# Relative, not absolute. Nginx proxies /api/ -> 127.0.0.1:8100 on the same
# origin, so the browser never makes a cross-origin request and CORS never
# fires. See deploy/nginx/resume.thetan.in.conf.
VITE_API_BASE_URL=/api

# Auto-compile debounce after typing stops (ms).
VITE_DEBOUNCE_MS=3000
