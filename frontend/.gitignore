dist.bad

# Local env only. .env.production IS committed on purpose — it holds no secrets,
# just VITE_API_BASE_URL=/api, and CI needs it to build a correct bundle.
.env
.env.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env copies/backups (.env.bak-prodcopy and friends). .env.production stays
# tracked on purpose — it holds no secrets and CI needs it to build.
.env.*
!.env.production
